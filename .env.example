# App: copy to .env and run npm start (Node 22+).
PORT=3000
# These two values are sent to the browser; use only the public/publishable key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional administrative seed tooling: use a SEPARATE .env.demo file.
# Never put service-role keys in .env app configuration or public assets.
# Audit/preview can use a SQL export without keys.
SUPABASE_SERVICE_ROLE_KEY=
# Used only for newly created selected demo accounts; never resets existing users.
DEMO_PRESENTATION_PASSWORD=
