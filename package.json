{
  "name": "fye-hub",
  "version": "1.0.0",
  "description": "A role-based student support platform connecting first-year students, mentors, supervisors and administrators.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MamilaGun23/fye-hub-MDU2.git"
  },
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-application.cjs",
    "test": "node --test --test-concurrency=2",
    "demo:audit": "node scripts/demo/cli.cjs audit",
    "demo:preview": "node scripts/demo/cli.cjs preview",
    "demo:check": "node scripts/demo/cli.cjs check",
    "demo:seed": "node scripts/demo/cli.cjs seed",
    "demo:trial": "node scripts/demo/cli.cjs trial",
    "demo:verify": "node scripts/demo/cli.cjs verify",
    "demo:access": "node scripts/demo/cli.cjs access",
    "demo:cleanup": "node scripts/demo/cli.cjs cleanup",
    "accounts:refresh": "node scripts/demo/refresh-appearance.cjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.65.0",
    "jsdom": "^30.1.3"
  }
}
